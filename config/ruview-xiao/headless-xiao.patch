+
+bool ruview_onboarding_target_is_private(const char *value)
+{
+    if (!valid_private_ipv4(value)) return false;
+    unsigned a, b, c, d;
+    char canonical[16];
+    if (sscanf(value, "%u.%u.%u.%u", &a, &b, &c, &d) != 4) return false;
+    snprintf(canonical, sizeof(canonical), "%u.%u.%u.%u", a, b, c, d);
+    return strcmp(canonical, value) == 0;
 }
 
